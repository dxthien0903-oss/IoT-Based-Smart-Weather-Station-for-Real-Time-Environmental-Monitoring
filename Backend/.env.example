# Sao chép file này thành .env rồi chỉnh giá trị thật
PORT=3000
DEVICE_API_KEY=doi-key-nay-thanh-chuoi-bi-mat-cua-ban
GEMINI_API_KEY=your-gemini-api-key-here

# ---------- Gemini: danh sách model (ưu tiên từ trái sang phải) ----------
# Google thu hồi model cũ (404) và có thể quá tải (503) — server tự thử lần lượt.
# Mặc định: gemini-3.5-flash, gemini-3.6-flash, gemini-3.5-flash-lite
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# ---------- Production / HTTPS ----------
# Bật khi chạy sau reverse proxy (Caddy, Nginx):
#   NODE_ENV=production
#   FORCE_HTTPS=true
#   CORS_ORIGIN=https://weather.example.com
#   TRUST_PROXY_HOPS=1
#
# Cloudflare Tunnel (KHÔNG bật FORCE_HTTPS — Cloudflare đã lo TLS ở edge):
# NODE_ENV=production
# CORS_ORIGIN=*
# TRUST_PROXY_HOPS=1

# Chứng chỉ PEM để chạy HTTPS trực tiếp (không qua reverse proxy):
# SSL_KEY_PATH=./certs/key.pem
# SSL_CERT_PATH=./certs/cert.pem

# ---------- Tùy chọn (có giá trị mặc định nếu bỏ trống) ----------
# OFFLINE_THRESHOLD_MS=30000
# DATA_RETENTION_DAYS=30
