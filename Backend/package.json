{
  "name": "weather-station-backend",
  "version": "1.1.0",
  "description": "Backend cho đồ án IoT-Based Smart Weather Station (ESP8266)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "simulate": "node simulate.js",
    "cert": "node generate-cert.js",
    "start:https": "node generate-cert.js && node -e \"process.env.SSL_KEY_PATH='./certs/key.pem';process.env.SSL_CERT_PATH='./certs/cert.pem';require('./server.js')\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "selfsigned": "^5.5.0"
  }
}
